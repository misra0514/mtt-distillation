ninja_required_version = 1.3
cxx = c++

cflags = -pthread -B /scratch/yguo25/anaconda3/envs/t2cu12/compiler_compat -Wno-unused-result -Wsign-compare -DNDEBUG -fwrapv -O2 -Wall -fPIC -O2 -isystem /scratch/yguo25/anaconda3/envs/t2cu12/include -fPIC -O2 -isystem /scratch/yguo25/anaconda3/envs/t2cu12/include -fPIC -I/scratch/yguo25/anaconda3/envs/t2cu12/lib/python3.9/site-packages/torch/include -I/scratch/yguo25/anaconda3/envs/t2cu12/lib/python3.9/site-packages/torch/include/torch/csrc/api/include -I/scratch/yguo25/anaconda3/envs/t2cu12/include/python3.9 -c
post_cflags = -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1016"' -DTORCH_EXTENSION_NAME=my_linear_double_backward -D_GLIBCXX_USE_CXX11_ABI=1 -std=c++17
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc







